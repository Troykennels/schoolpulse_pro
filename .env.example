# ══════════════════════════════════════════════════════════════════════
#  SchoolPulse v2.1 — Environment Variables
#  Copy this file to  server/.env  and fill in your values
# ══════════════════════════════════════════════════════════════════════

# ── Application ────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── JWT Secret ─────────────────────────────────────────────────────
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-64-chars-minimum

# ══════════════════════════════════════════════════════════════════════
#  FREE DATABASE OPTIONS (pick one)
# ══════════════════════════════════════════════════════════════════════

# ── OPTION 1: Supabase (RECOMMENDED — Free forever, 500 MB) ──────
#  1. Go to https://supabase.com  →  Sign up (free, no credit card)
#  2. Click "New Project" → choose a name, set a database password
#  3. Go to Project Settings → Database → Connection string → URI tab
#  4. Copy the URI — it looks like:
#     postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
#  5. Paste it below (replace the example)
#
#  TIP: For Vercel serverless, use the "Connection Pooler" URI instead:
#  Project Settings → Database → Connection Pooling → Connection string
#  postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
#
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres


# ── OPTION 2: CockroachDB (Free — 10 GB, PostgreSQL-compatible) ──
#  1. Go to https://cockroachlabs.com  →  Sign up free
#  2. Create a Serverless cluster
#  3. Connect → Connection string → copy the postgresql:// URI
#
# DATABASE_URL=postgresql://your_user:[PASSWORD]@free-tier.cockroachlabs.cloud:26257/defaultdb?sslmode=verify-full


# ── OPTION 3: Railway (Free $5 credit/month, resets monthly) ─────
#  1. Go to https://railway.app  →  Sign up
#  2. New Project → Provision PostgreSQL
#  3. Click the DB → Variables tab → copy DATABASE_URL
#
# DATABASE_URL=postgresql://postgres:[PASSWORD]@roundhouse.proxy.rlwy.net:[PORT]/railway


# ── OPTION 4: Local PostgreSQL (no internet needed) ──────────────
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=schoolpulse
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_SSL=false


# ── OPTION 5: SQLite (zero setup — great for local testing) ──────
# Just leave DATABASE_URL blank. SQLite file is auto-created at:
# server/data/schoolpulse.sqlite3


# ── Frontend URL (CORS) ────────────────────────────────────────────
# In production set this to your Vercel URL, e.g:
# CLIENT_URL=https://schoolpulse-xyz.vercel.app
CLIENT_URL=http://localhost:5173
